# Rust build artifacts
target/
**/*.rs.bk

# NOTE: Cargo.lock is intentionally COMMITTED. Airlock is an application/binary
# workspace, so a locked dependency set gives reproducible builds and pins
# security-relevant versions. (Run `git add Cargo.lock` after this change.)

# Node / Web artifacts
node_modules/
dist/
.vite/
*.log

# Large binary installers & packages (never commit these)
*.deb
*.rpm
*.dmg
*.iso

# Local caches & runtime state
.airlock/
.devsecops/
.pkgconfig/
.pkg-config-shims/
.lib-shims/
.DS_Store
*.tmp
*.bak
*-old
Claude outputs/
